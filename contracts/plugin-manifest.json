                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "domain": {
                    "type": "string",
                    "enum": [
                      "continuity",
                      "characters",
                      "promises",
                      "pacing",
                      "prose",
                      "canon"
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "suggestion",
                      "minor",
                      "major",
                      "critical"
